NODE_ENV=development
# Mettre "debug" pour diagnostiquer les recherches et les couvertures, "info" sinon.
LOG_LEVEL=info

# Cree avec @BotFather.
TELEGRAM_BOT_TOKEN=

# 16 a 64 caracteres parmi A-Z, a-z, 0-9, _ et -.
# Sert a construire le lien prive t.me/<bot>?start=<jeton>.
BOT_INVITE_TOKEN=

# Genere avec: openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=

# Genere avec: openssl rand -base64 32
OTP_HMAC_SECRET=

DATABASE_PATH=./data/books-bot.sqlite
FOURTOUTICI_BASE_URL=https://fourtoutici.cc
MAX_ATTACHMENT_BYTES=18874368
SEARCH_RESULT_TTL_MINUTES=30

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SKIP_SMTP_VERIFY=false
