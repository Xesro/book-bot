{
  "name": "books-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot Telegram prive pour rechercher et envoyer des livres par e-mail.",
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "file-type": "^22.3.0",
    "grammy": "^1.46.0",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
